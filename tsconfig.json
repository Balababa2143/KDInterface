{
    "compilerOptions": {
        "strict": true,
        "alwaysStrict": true,
        "strictBindCallApply": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "target": "ESNext",
        "module": "node16",
        "moduleResolution": "node16",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "lib": [
            "DOM",
            "ESNext",
            "ESNext.Array"
        ],
        "types": [
            "node"
        ],
        "skipLibCheck": true
    },
    "include": [
        "Src/**/*"
    ]
}